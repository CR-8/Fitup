# Environment: development | preview | production
# Copy this file to .env.local and fill in the values.

# --------------------------------------------------
# App identity
# --------------------------------------------------

# App display name (shown on home screen)
APP_NAME=Fitup

# App version (semver major.minor)
APP_VERSION=1.0

# Incremental build number (integer, e.g. unix timestamp)
APP_BUILD_NUMBER=1

# Bundle identifier — must match your provisioning profile / Play Console entry
APP_BUNDLE_IDENTIFIER=

# Build variant: development | preview | production
# Controls dev icon, Sentry project, and other per-environment behavior
APP_VARIANT=development

# --------------------------------------------------
# Apple (iOS builds & App Store submission)
# --------------------------------------------------

# Apple Developer Team ID (10-character string, find at developer.apple.com/account)
APP_APPLE_TEAM_ID=

# --------------------------------------------------
# Expo / EAS
# --------------------------------------------------

# EAS project ID (uuid, find at expo.dev project settings)
APP_EAS_PROJECT_ID=

# --------------------------------------------------
# Analytics
# --------------------------------------------------

# PostHog project API key and host
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# Analytics is enabled automatically for production builds. Set this to true only
# when a development or preview build intentionally needs to send test events.
EXPO_PUBLIC_ANALYTICS_ENABLED=false

# --------------------------------------------------
# Error tracking (Sentry)
# --------------------------------------------------

# Sentry DSN for runtime error reporting (find in Sentry project settings > Client Keys)
EXPO_PUBLIC_SENTRY_DSN=

# Sentry organization and project slugs (used for source map uploads during build)
APP_SENTRY_ORGANIZATION=
APP_SENTRY_PROJECT=

# Sentry auth token with project:releases and org:read scopes
# Generate at sentry.io/settings/auth-tokens/
SENTRY_AUTH_TOKEN=

# --------------------------------------------------
# Sync server
# --------------------------------------------------

# Optional base URL of a compatible SyncLayer provider.
# Leave empty for a local-only build.
EXPO_PUBLIC_SYNC_HOST=

# --------------------------------------------------
# Exercise media
# --------------------------------------------------

# Base URL of the object storage bucket serving exercise animations.
# Defaults to the Fitup bucket; override to point at your own storage.
EXPO_PUBLIC_EXERCISE_GIF_BASE_URL=

# --------------------------------------------------
# AI assistant
# --------------------------------------------------
#
# The client speaks the OpenAI chat-completions wire format, so switching providers is
# normally just a change of base URL, model, and key. Leave EXPO_PUBLIC_AI_BASE_URL
# empty to ship a build with the assistant switched off entirely.
#
#   OpenAI      https://api.openai.com/v1        gpt-4o-mini
#   OpenRouter  https://openrouter.ai/api/v1     anthropic/claude-sonnet-4
#   Cerebras    https://api.cerebras.ai/v1       <provider model id>
#   ZenMux      https://zenmux.ai/v1             <provider>/<model>
#   Groq        https://api.groq.com/openai/v1   llama-3.3-70b-versatile
#   Ollama      http://localhost:11434/v1        llama3.1
#
# Anthropic's own API uses a different request shape. Reach Claude through a gateway
# that presents an OpenAI-compatible surface rather than pointing at api.anthropic.com.

# Base URL of the provider or gateway, including any version segment.
EXPO_PUBLIC_AI_BASE_URL=

# Path appended to the base URL. Only change this for a non-standard gateway.
EXPO_PUBLIC_AI_COMPLETIONS_PATH=/chat/completions

# Transport: proxy | direct
#   proxy  — requests go to your own backend, which holds the provider credential.
#            No key ships in the app. Use this for anything you publish.
#   direct — requests go straight to the provider using the key below. The key is
#            extractable from the app binary, so this is for local or self-hosted
#            builds only.
# Leave empty to infer: direct when a key is set, proxy otherwise.
EXPO_PUBLIC_AI_TRANSPORT=

# Provider API key, used only in direct transport.
# THIS FILE IS COMMITTED. Put the real key in .env.local, which is gitignored.
EXPO_PUBLIC_AI_API_KEY=

# Model identifier, exactly as the provider names it.
EXPO_PUBLIC_AI_MODEL=gpt-4o-mini

# Sampling. Leave a value empty to omit it from the request so the provider's own
# default applies — not every gateway accepts every parameter.
# temperature       0.0-2.0   randomness; higher is more varied
# top_p             0.0-1.0   nucleus sampling; tune this OR temperature, not both
# max_tokens        integer   ceiling on the reply. Reasoning models spend part of
#                             this budget thinking, so keep it generous — you pay for
#                             tokens produced, not for headroom.
# frequency_penalty -2.0-2.0  discourages repeating the same tokens
# presence_penalty  -2.0-2.0  discourages repeating the same topics
# seed              integer   pins sampling for reproducible output, where supported
# Values outside these ranges are clamped rather than sent and rejected.
EXPO_PUBLIC_AI_TEMPERATURE=0.4
EXPO_PUBLIC_AI_TOP_P=
EXPO_PUBLIC_AI_MAX_TOKENS=8000
EXPO_PUBLIC_AI_FREQUENCY_PENALTY=
EXPO_PUBLIC_AI_PRESENCE_PENALTY=
EXPO_PUBLIC_AI_SEED=

# Extra headers as a JSON object, for gateways that require attribution.
# Example: {"HTTP-Referer":"https://fitup.app","X-Title":"Fitup"}
EXPO_PUBLIC_AI_HEADERS=

# Request timeout in milliseconds.
EXPO_PUBLIC_AI_TIMEOUT_MS=60000

# Plan generations allowed per calendar month. Enforced on the device for display
# only — real enforcement belongs on the server that holds the credential.
EXPO_PUBLIC_AI_MONTHLY_QUOTA=3

# Force the assistant on or off regardless of the base URL. Leave empty to enable
# whenever EXPO_PUBLIC_AI_BASE_URL is set.
EXPO_PUBLIC_AI_ENABLED=
