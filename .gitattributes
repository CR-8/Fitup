# Normalize all text files to LF in the repository and on checkout.
# Prettier is configured for LF, so a CRLF checkout (git config core.autocrlf=true,
# the default on Windows) would otherwise fail `bun run lint` on every line.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.wav binary
*.mp3 binary
*.jks binary
*.p12 binary
*.p8 binary
*.keystore binary
