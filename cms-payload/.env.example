# Payload's own secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Payload's own Postgres database (editorial copy: drafts, versions, admin
# users). Use a pooled connection string on Vercel, e.g. the Supabase
# transaction pooler (port 6543).
DATABASE_URL=

# Where publishing syncs to and refreshes embeddings for: the app's own
# Supabase project, not Payload's database.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_FUNCTIONS_URL=https://<project>.supabase.co/functions/v1

# Same basic-auth credentials set on the syn-backfill Edge Function
# (`supabase secrets set ADMIN_USER=... ADMIN_PASSWORD=...`).
SYN_BACKFILL_ADMIN_USER=
SYN_BACKFILL_ADMIN_PASSWORD=
