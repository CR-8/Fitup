# Strapi's own secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=

# Strapi's own database. Leave unset for SQLite (zero setup, fine for local
# dev). Set to postgres for a deployed instance.
DATABASE_CLIENT=sqlite
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgres://user:password@host:5432/strapi

# Where publishing syncs to and refreshes embeddings for. This is the app's
# own Supabase project, not Strapi's database.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_FUNCTIONS_URL=https://<project>.supabase.co/functions/v1

# Same basic-auth credentials already set on the syn-backfill Edge Function
# (`supabase secrets set ADMIN_USER=... ADMIN_PASSWORD=...`).
SYN_BACKFILL_ADMIN_USER=
SYN_BACKFILL_ADMIN_PASSWORD=
