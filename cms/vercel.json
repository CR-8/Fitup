{
    "version": 2,
    "buildCommand": "npm run build",
    "builds": [
        {
            "src": "api/index.js",
            "use": "@vercel/node",
            "config": {
                "includeFiles": ["dist/**", "public/**", "src/**", "package.json"]
            }
        }
    ],
    "routes": [{ "src": "/(.*)", "dest": "api/index.js" }]
}
