{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "jsx": "react-native",
        "paths": {
            "@/*": ["./src/*"],
            "live-activity": ["./modules/live-activity/src/index"],
        },
    },
    "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
    // Neither of these targets React Native, and compiling them here would
    // demand their runtime's types as app dependencies to check code that never
    // ships in the app.
    //
    // `supabase/functions` is retired CMS-era Deno code, kept only until
    // `cms` (Strapi) is confirmed in and it is deleted outright; it reaches
    // for `Deno.serve` and imports Hono through an `npm:` specifier, both
    // errors under this config, and it has its own `deno.json` — check it
    // with `deno check`, not this.
    //
    // `cms` is Strapi and `cms-payload` is Payload on Next.js: separate Node
    // apps with their own dependency trees and tsconfigs, never the app's
    // runtime, so neither may be type-checked or bundled as part of the client.
    // Android's presentation lives in `*.android.*` siblings and is checked by
    // `tsconfig.android.json`, which resolves imports the way Metro does there.
    "exclude": [
        "cms",
        "cms-payload",
        "supabase/functions",
        "**/*.android.ts",
        "**/*.android.tsx",
    ],
}
