{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "jsx": "react-native",
        "paths": {
            "@/*": ["./src/*"],
            "live-activity": ["./modules/live-activity/src/index"],
        },
    },
    "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
    // Neither of these targets React Native, and compiling them here would
    // demand their runtime's types as app dependencies to check code that never
    // ships in the app.
    //
    // `supabase/functions` is the CMS, which runs on Deno: it reaches for
    // `Deno.serve` and imports Hono through an `npm:` specifier, and both are
    // errors under this config. It has its own `deno.json`; check it with
    // `deno check`.
    //
    // `workers` is the retired Cloudflare pair, kept until the cutover is done.
    "exclude": ["workers", "supabase/functions"],
}
